# LLM provider: anthropic | openai | gemini | mock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_actual_key_here
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini has a genuinely free tier (no billing required) - get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_actual_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Where the two app repos live, relative to this directory
BACKEND_SRC_DIR=../fidar-server/src/main/java
FRONTEND_SRC_DIR=../CallCenterUI/client/src
# CallCenterUI's own Express server (its BFF/API-proxy layer) - scanned so the
# planner/validator know the real browser-visible API surface, not just the
# Spring Boot layer behind it.
FRONTEND_SERVER_SRC_DIR=../CallCenterUI/server

# The running apps under test
APP_BASE_URL=http://localhost:5000
API_BASE_URL=http://localhost:8084/fidar/sdk/api

# Optional bearer token for authenticated flows. Never point this at a
# secrets/properties file from the app repos - supply your own test credential.
APP_AUTH_TOKEN=

# If the app under test has a login page, provide credentials here and the
# executor will sign in automatically before running each scenario.
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD=

# Playwright MCP browser mode
MCP_HEADLESS=true

# Old CLI + vanilla-JS dashboard (superseded by the AI Testing Platform below,
# kept until server/+web/ reach parity)
DASHBOARD_PORT=4700

# --- AI Testing Platform (server/ + web/) ---
SERVER_PORT=4701
DB_PATH=data/platform.db
# A separate sibling directory (its own git repo) the platform commits
# generated Playwright tests into. Never points at fidar-server/ or
# CallCenterUI/ - those stay strictly read-only system-under-test repos.
MANAGED_REPO_DIR=../generated-tests-repo
MANAGED_REPO_BRANCH=main
